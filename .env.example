# Copy to .env and fill in. Never commit .env.

# Postgres (local docker compose default; replace with your Neon URL later)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/civic
# Read-only user the SQL agent uses (created by db/init.sql)
READONLY_DATABASE_URL=postgresql://civic_reader:change-me@localhost:5432/civic

# Chicago Data Portal app token (free): https://data.cityofchicago.org
SODA_APP_TOKEN=

# Gemini API key (free tier): https://aistudio.google.com
GEMINI_API_KEY=

# Key clients must send in the X-API-Key header
SERVICE_API_KEY=change-me

# Request limits for /query (0 = off); days end at midnight Pacific
RATE_LIMIT_PER_MINUTE=5
RATE_LIMIT_PER_DAY=50
RATE_LIMIT_TOTAL_PER_DAY=500
# Proxies in front of the app (0 locally, 1 on Cloud Run): how the client's IP is found
TRUSTED_PROXIES=0
# Log the text of each question (off: only its length)
LOG_QUESTIONS=false
